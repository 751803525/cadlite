{
  "name": "cadlite",
  "version": "0.1.0",
  "description": "Industrial CAD to Web 3D lightweight pipeline",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cadlite": "bin/cadlite.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "cross-env NODE_OPTIONS=\"--experimental-wasm-modules\" tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cad",
    "step",
    "3d",
    "glb",
    "gltf",
    "optimization"
  ],
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "inquirer": "^10.2.2",
    "opencascade-convert": "^0.2.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.5.5",
    "@typescript-eslint/eslint-plugin": "^8.6.0",
    "@typescript-eslint/parser": "^8.6.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.10.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}