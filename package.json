{
  "name": "cadlite",
  "version": "0.1.0",
  "description": "Industrial CAD to Web 3D lightweight pipeline",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cadlite": "bin/cadlite.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "tsx src/test-bom.ts",
    "start": "node dist/index.js",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cad",
    "step",
    "3d",
    "glb",
    "gltf",
    "optimization"
  ],
  "license": "MIT",
  "dependencies": {
    "@types/three": "^0.185.4",
    "chalk": "^5.3.0",
    "chardet": "^2.2.0",
    "commander": "^12.1.0",
    "fs-extra": "^11.4.0",
    "iconv-lite": "^0.7.3",
    "inquirer": "^10.2.2",
    "opencascade-convert": "^0.2.0",
    "opencascade.js": "^1.1.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.4.2",
    "@types/chardet": "^1.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/iconv-lite": "^0.0.1",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.5.5",
    "@typescript-eslint/eslint-plugin": "^8.6.0",
    "@typescript-eslint/parser": "^8.6.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.10.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}